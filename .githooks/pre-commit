#!/bin/sh
# Refuses to commit anything that looks like a live credential.
#
# The scan lives in scripts/scan-secrets.mjs so that the hook and CI share one
# pattern list, and so the patterns can test themselves. `--staged` runs that
# self-test before scanning, which is deliberate: an earlier shell version of this
# guard used BRE interval syntax with `grep -E` and silently matched nothing.
exec node scripts/scan-secrets.mjs --staged
