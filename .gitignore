# Secrets. Never commit. See .env.example for the shape.
.env
.env.local
.env.*.local

# Local database (PGlite data directory)
.data/

# Build output
.next/
out/
dist/

# Generated by Next, and its contents differ between `next dev` and `next build`
# (.next/dev/types vs .next/types), so committing it produces a phantom diff on
# every mode switch. Typecheck does not need it: verified with tsc --noEmit.
next-env.d.ts

# Dependencies
node_modules/

# Test and coverage output
coverage/
*.tsbuildinfo

# Python (offline training and evaluation)
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
# The JSON report `npm run test:ci` emits for scripts/generate-evidence.mjs.
.vitest-report.json

# Third-party design reference used while building the visual system. Kept locally,
# not redistributed: see the note in app/globals.css.
frontend-design-inspiration/

.vercel
.env*
